; Ichigo P1 camera laboratory — provisional art and camera settings.
config_version=5

[application]
config/name="Ichigo — 02 Faded Tides"
run/main_scene="res://game/camera_study.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Faded Tides: sunbleached engraved currents and broad scalloped swells."

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.76, 0.80, 0.75, 1)
